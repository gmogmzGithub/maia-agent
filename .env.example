# Copy this file to .env and fill the required secrets. Docker Compose owns all
# hostnames, ports, and internal paths, so they do not belong in this file.
# .env is git-ignored. Never commit it.

# --- Product behavior ---------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0
MAX_CONCURRENT_CONVERSATIONS=3
# DEBUG shows lifecycle, JSON-RPC, and tool tracing with secrets and message
# bodies redacted or summarized. Set INFO for quieter operator logs.
LOG_LEVEL=DEBUG

# --- Required local secrets ---------------------------------------------------
# Generate a different value for each with: openssl rand -hex 32
HERMES_DASHBOARD_SESSION_TOKEN=
PLUGIN_API_TOKEN=
DEVELOPER_BASIC_PASSWORD=

# One fixed local Developer credential protects Property Document uploads.
DEVELOPER_BASIC_USER=developer

# --- Model selection (see roles/MODELS.md) ------------------------------------
# Sonnet is the one to use for the Lead-facing Sales Role before a live pilot;
# roles/MODELS.md has the measured trade-offs in both directions.
MODEL_PROVIDER=anthropic
SALES_MODEL=claude-haiku-4-5-20251001
ADMIN_MODEL=claude-haiku-4-5-20251001
# Required to run real conversations with the default provider. Hermes can
# still boot and pass protocol health checks while this is empty.
ANTHROPIC_API_KEY=

# --- Telegram Administrative Channel (P-040) ----------------------------------
# Bot token from @BotFather, and the numeric Telegram user ids allowed to reach
# the Administrative Role (Broker and Developer), comma separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# --- Meta WhatsApp Cloud API (P-021) ------------------------------------------
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=

# --- Google Calendar (P-054, P-055, P-056) -------------------------------------
# Optional service-account JSON path inside the Product container. Put the key
# at secrets/google-calendar.json and use the path below when enabling Calendar.
GOOGLE_CALENDAR_CREDENTIALS=
# GOOGLE_CALENDAR_CREDENTIALS=/run/secrets/google-calendar.json
GOOGLE_CALENDAR_ID=

# --- Appointments (docs/decisions/checkpoint-3-inputs.md) -------------------
TIMEZONE=America/Mexico_City
# Keep this quoted so Compose passes the complete semicolon-delimited value.
WEEKLY_SCHEDULE="mon=09:00-17:00;tue=09:00-17:00;wed=09:00-17:00;thu=09:00-17:00;fri=09:00-17:00;sat=10:00-17:00;sun=10:00-17:00"
VISIT_MINUTES=90
BOOKING_HORIZON_DAYS=8
MAX_SLOT_CANDIDATES=6
BROKER_DIGEST_HOUR=8
BROKER_REMINDER_MINUTES_BEFORE=90
