# Stage 0 local configuration.
#
# Copy to .env (scripts/bootstrap.sh does this and generates the secrets).
# .env is git-ignored. No secret may be committed, logged, or written into a
# Property Document (P-051).

# --- Deterministic Backend (ADR-0006) ---------------------------------------
DATABASE_URL=postgresql+psycopg://realestate:realestate@127.0.0.1:5433/realestate

# --- Product application ------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8080
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0
MAX_CONCURRENT_CONVERSATIONS=3
# DEBUG shows lifecycle, JSON-RPC, and tool tracing with secrets and message
# bodies redacted or summarized. Set INFO for quieter operator logs.
LOG_LEVEL=DEBUG

# --- Hermes Runtime boundary (ADR-0008) ---------------------------------------
# The product and `hermes serve` must share this token. It authenticates the
# local JSON-RPC WebSocket upgrade; generated by scripts/bootstrap.sh.
HERMES_DASHBOARD_SESSION_TOKEN=
HERMES_BASE_URL=http://127.0.0.1:9119
HERMES_PORT=9119
# Pinned upstream version. Only re-pin after re-verifying the JSON-RPC
# capability contract in src/realestate/hermes/client.py::REQUIRED_METHODS.
HERMES_PINNED_VERSION=0.20.0
HERMES_TIMEOUT_SECONDS=10.0
# Optional path override for scripts/bootstrap.sh. Leave empty to use the
# sibling checkout at ~/workspace/repos/hermes-agent.
HERMES_CHECKOUT=

# --- Plugin -> Product application boundary (ADR-0009) ------------------------
# Read by the product as PLUGIN_API_TOKEN and by the plugin (inside the Hermes
# process) as REALESTATE_PLUGIN_API_TOKEN. Both must hold the same value.
PLUGIN_API_TOKEN=
REALESTATE_PLUGIN_API_TOKEN=
REALESTATE_BACKEND_URL=http://127.0.0.1:8080
REALESTATE_BACKEND_TIMEOUT=15.0

# --- Property Document ingestion (P-045, P-051) -------------------------------
# The single Developer credential for the upload page. Generated by
# scripts/bootstrap.sh; there is no user-account subsystem.
DEVELOPER_BASIC_USER=developer
DEVELOPER_BASIC_PASSWORD=
# Immutable content-addressed artifacts for accepted documents.
ARTIFACT_ROOT=var/property-documents

# --- Hermes Role profiles (ADR-0001) ------------------------------------------
# Each Role has its own Hermes profile under hermes-home/profiles/<name>/, whose
# SOUL.md is that Role's byte-stable guide (source of truth: roles/<name>/).
HERMES_SALES_PROFILE=sales
HERMES_ADMIN_PROFILE=admin

# --- Model selection (see roles/MODELS.md) ------------------------------------
# One line per Role. Apply with ./scripts/apply-models.sh, then restart Hermes.
# Sonnet is the one to use for the Lead-facing Sales Role before a live pilot;
# roles/MODELS.md has the measured trade-offs in both directions.
MODEL_PROVIDER=anthropic
SALES_MODEL=claude-haiku-4-5-20251001
ADMIN_MODEL=claude-haiku-4-5-20251001

# --- Telegram Administrative Channel (P-040) ----------------------------------
# Bot token from @BotFather, and the numeric Telegram user ids allowed to reach
# the Administrative Role (Broker and Developer), comma separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# --- Meta WhatsApp Cloud API (P-021) ------------------------------------------
# META_APP_ID and PUBLIC_BASE_URL are retained for webhook/app registration
# workflows. The current Product webhook uses the secret, verify token, and
# phone number settings below directly.
META_APP_ID=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
PUBLIC_BASE_URL=

# --- Google Calendar (P-054, P-055, P-056) -------------------------------------
# Service-account JSON file and the calendar used as the Broker's source of
# truth for free/busy and appointment creation.
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=

# --- Appointments (docs/decisions/checkpoint-3-inputs.md) -------------------
TIMEZONE=America/Mexico_City
# MUST stay quoted: shell scripts source this file and ';' would truncate it.
WEEKLY_SCHEDULE="mon=09:00-17:00;tue=09:00-17:00;wed=09:00-17:00;thu=09:00-17:00;fri=09:00-17:00;sat=10:00-17:00;sun=10:00-17:00"
VISIT_MINUTES=90
BOOKING_HORIZON_DAYS=8
MAX_SLOT_CANDIDATES=6
BROKER_DIGEST_HOUR=8
BROKER_REMINDER_MINUTES_BEFORE=90

# --- Testing overrides ---------------------------------------------------------
# Leave TEST_DATABASE_URL empty to derive a separate <development>_test
# database from DATABASE_URL. Set RUN_CONVERSATION_TESTS=1 only when a model
# provider key is available and the live conversation tests are intentional.
TEST_DATABASE_URL=
RUN_CONVERSATION_TESTS=0
