# Copy this file to .env and fill in the secrets. Docker Compose owns database
# settings, service addresses, ports, and container paths.
# .env is git-ignored. Never commit it.

# Product variables
# Keep the background loop enabled for normal operation. When disabled, the API
# remains available, but Maia does not process incoming messages or send queued
# work.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0
# Maximum number of lead conversations that Maia may process through Hermes at
# the same time.
MAX_CONCURRENT_CONVERSATIONS=3
# Use INFO for quieter logs.
LOG_LEVEL=DEBUG

# Maia document upload variables
DEVELOPER_BASIC_USER=developer
DEVELOPER_BASIC_PASSWORD=

# Hermes variables
# Shared secret used only to authenticate Maia's connection to the local Hermes
# JSON-RPC WebSocket. Generate with: openssl rand -hex 32
HERMES_DASHBOARD_SESSION_TOKEN=
# Shared secret used by the Hermes plugin when it calls Maia's Product API.
# Generate with: openssl rand -hex 32
PLUGIN_API_TOKEN=
REALESTATE_BACKEND_TIMEOUT=15.0

# Model variables
MODEL_PROVIDER=anthropic
SALES_MODEL=claude-haiku-4-5-20251001
ADMIN_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Telegram variables
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use Maia's
# administrative role.
TELEGRAM_ADMIN_IDS=

# Meta WhatsApp variables
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Google Calendar variables
# Place the service-account JSON at secrets/google-calendar.json, then use the
# container path shown below.
GOOGLE_CALENDAR_CREDENTIALS=
# GOOGLE_CALENDAR_CREDENTIALS=/run/secrets/google-calendar.json
GOOGLE_CALENDAR_ID=

# Appointment variables
TIMEZONE=America/Mexico_City
# Keep this quoted so Compose passes the complete semicolon-delimited value.
WEEKLY_SCHEDULE="mon=09:00-17:00;tue=09:00-17:00;wed=09:00-17:00;thu=09:00-17:00;fri=09:00-17:00;sat=10:00-17:00;sun=10:00-17:00"
VISIT_MINUTES=90
BOOKING_HORIZON_DAYS=8
MAX_SLOT_CANDIDATES=6
BROKER_DIGEST_HOUR=8
BROKER_REMINDER_MINUTES_BEFORE=90

# Test variables
# Set to 1 only when intentionally running tests that call the model provider.
RUN_CONVERSATION_TESTS=0
