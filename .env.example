# Copy this file to .env and fill in the secrets. Docker Compose owns database
# settings, service addresses, ports, and container paths.
# .env is git-ignored. Never commit it.

# Product variables
# Keep the background loop enabled for normal operation. When disabled, the API
# remains available, but Maia does not process incoming messages or send queued
# work.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0
# Maximum number of lead conversations that Maia may process through Hermes at
# the same time.
MAX_CONCURRENT_CONVERSATIONS=3
# Use INFO for quieter logs.
LOG_LEVEL=DEBUG

# Maia document upload variables
# JSON object of local Basic-auth accounts. Values are secrets; do not commit them.
DEVELOPER_BASIC_CREDENTIALS_JSON=
# Compatibility fallback for a single local account.
DEVELOPER_BASIC_USER=developer
DEVELOPER_BASIC_PASSWORD=

# Organization roles (Stage 2). Non-secret. Which authenticated logins act as
# Organization Administrators and which as Real Estate Advisors. A login listed
# in both administers and also advises. Membership itself lives in PostgreSQL;
# these values are reconciled into it at startup.
ORGANIZATION_ADMIN_LOGINS=developer
ORGANIZATION_ADVISOR_LOGINS=developer
# The deterministic assignment fallback. Optional when there is one Advisor.
ORGANIZATION_DEFAULT_ADVISOR_LOGIN=developer

# Per-Advisor operational configuration (Stage 3). Non-secret. Both are also
# editable by an Organization Administrator in /crm/equipo, and configuration
# never clears a value set there — an unset variable is not an instruction to
# erase one (ADR-0047).
#
# login=calendar-id pairs. An Advisor with no authoritative calendar cannot
# receive a visit: Product refuses rather than treating an unreadable calendar
# as a free week (ADR-0048). GOOGLE_CALENDAR_ID below is used for the default
# Advisor when no pair names them, so a single-calendar setup keeps working.
ORGANIZATION_MEMBER_CALENDARS=
# login=telegram-chat-id pairs, for the immediate alert a human handoff raises.
# Optional: without one the alert is still durable and visible in the CRM, and
# the Administrators are told it could not be delivered.
ORGANIZATION_MEMBER_TELEGRAM_IDS=

# Hermes variables
# Shared secret used only to authenticate Maia's connection to the local Hermes
# JSON-RPC WebSocket. Generate with: openssl rand -hex 32
HERMES_DASHBOARD_SESSION_TOKEN=
# Shared secret used by the Hermes plugin when it calls Maia's Product API.
# Generate with: openssl rand -hex 32
PLUGIN_API_TOKEN=
# Dedicated loopback secret used only by the public Site when it calls Product.
# Generate with: openssl rand -hex 32
SITE_PRODUCT_API_TOKEN=
SITE_PUBLIC_ORIGIN=http://localhost:8080
# Digits-only or international display format; leave empty to show the handoff reference.
OFFICIAL_WHATSAPP_NUMBER=
REALESTATE_BACKEND_TIMEOUT=15.0

# EasyBroker read-only Product adapter. Keep the account key server-side only.
# MLS activation is intentionally absent from this secret template and remains
# fail-closed until the account plan and collaboration permissions are confirmed.
EASYBROKER_API_KEY=

# Model variables
MODEL_PROVIDER=anthropic
SALES_MODEL=claude-haiku-4-5-20251001
ADMIN_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Telegram variables
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use Maia's
# administrative role.
TELEGRAM_ADMIN_IDS=

# Meta WhatsApp variables
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Google Calendar variables
# Place the service-account JSON at secrets/google-calendar.json, then use the
# container path shown below.
GOOGLE_CALENDAR_CREDENTIALS=
# GOOGLE_CALENDAR_CREDENTIALS=/run/secrets/google-calendar.json
GOOGLE_CALENDAR_ID=

# Appointment variables
TIMEZONE=America/Mexico_City
# Keep this quoted so Compose passes the complete semicolon-delimited value.
WEEKLY_SCHEDULE="mon=09:00-17:00;tue=09:00-17:00;wed=09:00-17:00;thu=09:00-17:00;fri=09:00-17:00;sat=10:00-17:00;sun=10:00-17:00"
VISIT_MINUTES=90
BOOKING_HORIZON_DAYS=8
MAX_SLOT_CANDIDATES=6
BROKER_DIGEST_HOUR=8
BROKER_REMINDER_MINUTES_BEFORE=90
# The local hour a Contact-facing day-of visit reminder is due. Configuration
# rather than a number chosen in code, because when a customer should be
# messaged is an operational decision. Dispatch is currently blocked regardless:
# the reminder cadence is an unvalidated hypothesis (SAN-036).
APPOINTMENT_DAY_OF_REMINDER_HOUR=9

# Test variables
# Set to 1 only when intentionally running tests that call the model provider.
RUN_CONVERSATION_TESTS=0
