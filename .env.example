# Copia este archivo a .env. Las credenciales externas se configuran localmente.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-exposing
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://maia:maia_local@localhost:15432/maia
POSTGRES_DB=maia
POSTGRES_USER=maia
POSTGRES_PASSWORD=maia_local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000

# Google Calendar. Configura estos valores antes de conectar asesores.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
# Clave Fernet, generada una sola vez y conservada fuera de la base de datos.
CALENDAR_ENCRYPTION_KEY=

# WhatsApp Cloud API. Versión habilitada en la aplicación de Meta, por ejemplo vXX.0.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
