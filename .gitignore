.venv/
.venv-hermes/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Secrets — never commit. See .env.example for the required keys.
.env
.env.*
!.env.example

# Local Hermes profile state (config.yaml is generated by scripts/hermes-profile.sh)
hermes-home/*
!hermes-home/.gitkeep

# Accepted Property Document artifacts (Checkpoint 1)
var/

# Local/private working notes. Keep raw imports and personal memory out of the
# public GitHub history.
private-notes/
